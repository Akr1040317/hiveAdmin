# Admin Firebase Configuration (for authentication)
# Hive Admin Firebase Project
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyASpqrZfrP9PlY5iR0aW5Rc8VSyuEXEWqE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hiveadmin-fb9e0.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hiveadmin-fb9e0
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hiveadmin-fb9e0.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=210842197707
NEXT_PUBLIC_FIREBASE_APP_ID=1:210842197707:web:d1db1a48698d6163e2854e

# Firebase Project IDs
ADMIN_FIREBASE_PROJECT_ID=hiveadmin-fb9e0
PREPCENTER_FIREBASE_PROJECT_ID=prepcenter-750c1
HIVE_FIREBASE_PROJECT_ID=beeapp-5c98b

# Service Account Credentials (server-side only)
# Option 1: JSON string (recommended for Vercel/deployment)
# Get service account JSON from Firebase Console > Project Settings > Service Accounts
# Paste the entire JSON content as a single-line string
FIREBASE_SERVICE_ACCOUNT_ADMIN={"type":"service_account","project_id":"hiveadmin-fb9e0","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT_PREPCENTER={"type":"service_account","project_id":"prepcenter-750c1","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT_HIVE={"type":"service_account","project_id":"beeapp-5c98b","private_key":"...","client_email":"..."}

# Option 2: File paths (for local development)
# Place service account JSON files in ./service-accounts/ directory
# These files are already in .gitignore - DO NOT commit them
# Use exact filename - no wildcards
FIREBASE_SERVICE_ACCOUNT_PATH_ADMIN=./service-accounts/hiveadmin-fb9e0-firebase-adminsdk-fbsvc-8429a5d36f.json
FIREBASE_SERVICE_ACCOUNT_PATH_PREPCENTER=./service-accounts/prepcenter-750c1-firebase-adminsdk-fbsvc-7e15094e23.json
FIREBASE_SERVICE_ACCOUNT_PATH_HIVE=./service-accounts/beeapp-5c98b-firebase-adminsdk-g6vl0-0c34f5c176.json

# Optional: comma-separated allowlist (or use Firestore /config/allowlist in admin project)
# NOTE: Must use NEXT_PUBLIC_ prefix for client-side access
NEXT_PUBLIC_ALLOWED_EMAILS=admin@example.com

# Google Calendar API Configuration
# Option 1: JSON string (recommended for Vercel/deployment)
# Get service account JSON from Google Cloud Console > IAM & Admin > Service Accounts
# Create a service account, enable Google Calendar API, and download the JSON key
# Paste the entire JSON content as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"...","client_email":"..."}

# Option 2: File path (for local development)
# Place service account JSON file in project root or service-accounts directory
# The service account file is already in service-accounts/google-calendar-service-account.json
GOOGLE_SERVICE_ACCOUNT_PATH=./service-accounts/google-calendar-service-account.json

# Google Calendar ID (default: "primary" for primary calendar)
# For a shared calendar, use the calendar email address or calendar ID
GOOGLE_CALENDAR_ID=primary

# Google API Key (required on Vercel/serverless to fix 403 "unregistered callers")
# Create in same GCP project as service account (e.g. prepcenter-750c1): APIs & Services → Credentials → Create credentials → API key
# Verification checklist (prepcenter-750c1): Application restrictions = None; API restrictions = Don't restrict key or Google Calendar API;
# Google Calendar API enabled for project; Billing linked if required; Service account (GOOGLE_SERVICE_ACCOUNT_JSON) from same project; Redeploy after env changes
GOOGLE_API_KEY=
